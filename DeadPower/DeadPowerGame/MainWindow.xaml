<Window x:Name="DeadPowerGame" x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeadPowerGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="850">
    <Canvas x:Name="mainCanvas">
        <Canvas.Background>
            <ImageBrush ImageSource="/Assets/images/RoomDark.png"/>
        </Canvas.Background>
        <Label x:Name="lblPlayerName" Content="Player Name"
             Foreground="#C9A84C" FontSize="16" FontWeight="Bold" Margin="10"/>
        <Label x:Name="lblHealth" Content="Health:" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Width="292" Canvas.Left="19" Canvas.Top="88" Background="#FFDB2C2C" />
        <ProgressBar x:Name="pbarPlayerHealth" Height="16"
                   Foreground="#AA3030" Canvas.Left="14" Width="218" Canvas.Top="56"/>
        <Label x:Name="lblPlayerHealth" Content="100 / 100"
             Foreground="Black" FontSize="12" Background="#FFDED2D2" Canvas.Left="326" Canvas.Top="88"/>
        <Label Content="INVENTORY" Foreground="#C9A84C"
             FontSize="11" FontWeight="Bold" Canvas.Left="39" Canvas.Top="290"/>
        <ListBox x:Name="lstInventory" Background="#1A1814"
               Foreground="Black" Height="74" Canvas.Left="15" Canvas.Top="314" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120"/>



        <Label x:Name="lblRoomName" Grid.Row="0"
             Content="Entrance Hall" Foreground="#F0D080"
             FontSize="22" FontWeight="Bold" Canvas.Left="326" Canvas.Top="26"/>

        <Label x:Name="lblEnemyStatus" Foreground="White" FontSize="13" Canvas.Left="670" Canvas.Top="75" HorizontalAlignment="Center" Height="36" VerticalAlignment="Top" Width="85" Background="#FFD5D1D1"/>

        <ProgressBar x:Name="pbarEnemyHealth" Height="14"
                   Foreground="#8B0000" HorizontalAlignment="Left" Canvas.Left="554" VerticalAlignment="Top" Width="236" Canvas.Top="191"/>


        <Label x:Name="lblNpcName" Content="NPC Name" Canvas.Left="670" Canvas.Top="46" Background="#FFFDF6F6"/>
        <TextBox x:Name="txtNpcDialogue" IsReadOnly="True" TextWrapping="Wrap" Text="NPC Dialogue" Width="120" Height="78" Canvas.Left="670" Canvas.Top="250" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Button x:Name="btnLightSwitch" Content="Toggle Lights" Canvas.Left="704" Canvas.Top="358" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <TextBox x:Name="txtCombatLog" Grid.Row="3"
               IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Background="#0E0C0A" Foreground="#C9E0A0"
               FontFamily="Consolas" FontSize="12" Canvas.Left="144" Canvas.Top="364" HorizontalAlignment="Left" VerticalAlignment="Top" Width="512" Height="40"/>
        <Image x:Name="imgPlayer" Height="100" Canvas.Left="180" Canvas.Top="250" Width="100" Source="/Assets/images/Soldier.png"/>
        <Image x:Name="imgEnemy" Height="100" Canvas.Left="528" Canvas.Top="273" Width="100" Source="/Assets/images/Zombie.png"/>

        <Button x:Name="btnNorth" Content="▲ North" Width="120" Click="btnNorth_Click" HorizontalAlignment="Left" Canvas.Left="340" Canvas.Top="11" VerticalAlignment="Top"/>
        <Button x:Name="btnSouth" Content="▼ South" Width="131" Click="btnSouth_Click" HorizontalAlignment="Left" Canvas.Left="356" Canvas.Top="331" VerticalAlignment="Top"/>
        <Button x:Name="btnEast"  Content="▶ East"  Width="90" Click="btnEast_Click" Canvas.Left="670" Canvas.Top="221"/>
        <Button x:Name="btnWest"  Content="◀ West"  Width="90" Click="btnWest_Click" Canvas.Left="10" Canvas.Top="226"/>
        <Button x:Name="btnAttack" Content="⚔ Attack"
              Visibility="Collapsed" Click="btnAttack_Click" Canvas.Left="541" Canvas.Top="231"/>
        <Button x:Name="btnSave" Content="💾 Save Game" Click="btnSave_Click" Canvas.Left="228" Canvas.Top="11"/>
        <Image x:Name="imgWest" Height="374" Canvas.Left="-18" Canvas.Top="34" Width="41" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image x:Name="imgEast" Height="374" Canvas.Left="778" Canvas.Top="41" Width="40" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image x:Name="imgNorth" Height="58" Canvas.Left="135" Canvas.Top="26" Width="566" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="imgSouth" Height="44" Canvas.Left="55" Canvas.Top="415" Width="706" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    </Canvas>
</Window>

 